<Page x:Class="GDUTClassHelper.Desktop.View.Pages.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GDUTClassHelper.Desktop.View.Pages"
      xmlns:vm="clr-namespace:GDUTClassHelper.Desktop.ViewModel.Pages"
      d:DataContext="{d:DesignInstance vm:CalendarPageVM}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CalendarPage">

    <Grid>
        <ItemsControl ItemsSource="{Binding ColInfos}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding DayOfWeek}"/>
                        <Canvas>
                            <ItemsControl>
                                
                            </ItemsControl>
                        </Canvas>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Canvas>
            <TextBlock Width="{Binding}">aaa</TextBlock>
        </Canvas>
    </Grid>
</Page>
