<Page x:Class="GDUTClassHelper.Desktop.View.Pages.DataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GDUTClassHelper.Desktop.View.Pages"
      xmlns:vm="clr-namespace:GDUTClassHelper.Desktop.ViewModel.Pages"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance vm:DataPageVM}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DataPage">

    <Grid ColumnDefinitions="*,2*">
        <StackPanel Grid.Column="0">
            <Button Content="读取并解析文件" Command="{Binding BrowseAndAnaylsisFileCommand}"/>
            <Grid ColumnDefinitions="auto,*">
                <Button Grid.Column="0" Content="保存数据" Command="{Binding SaveDataCommand}"/>
                <TextBox Grid.Column="1" Text="{Binding SaveFileName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveDataCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Grid.Column="1" Text="在此输入保存的文件名" IsHitTestVisible="False" Foreground="Gray" Visibility="{Binding HintTextVisibility}" VerticalAlignment="Center"/>
            </Grid>
            <Button Content="并入选中文件" Command="{Binding MergeIntoSeletedFileCommand}"/>
            <Button Content="打开数据文件夹" Command="{Binding OpenDataDirCommand}"/>
        </StackPanel>
        <Grid Grid.Column="1" RowDefinitions="auto,*">
            <Button Grid.Row="0" Content="刷新/清空选择" Command="{Binding RefreshFileNameListCommand}"/>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding FileNameList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock><Run Text=" ["/><Run Text="{Binding Status}"/><Run Text="] "/></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Page>
