<Window x:Class="GDUTClassHelper.Desktop.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GDUTClassHelper.Desktop.View"
        xmlns:vm="clr-namespace:GDUTClassHelper.Desktop.ViewModel"
        d:DataContext="{d:DesignInstance vm:MainWindowVM}"
        mc:Ignorable="d"
        Title="GDUTClassHelper" Height="450" Width="800">
    <Grid RowDefinitions="*,auto">
        <Grid Grid.Row="0" ColumnDefinitions="auto,*">
            <ListBox Grid.Column="0" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding Pages}"/>
            <Frame Grid.Column="1" NavigationUIVisibility="Hidden" Content="{Binding CurrentPage}"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="auto,*" Background="White" Height="16">
            <Rectangle Grid.Column="0" Fill="{Binding StatusBarColor}" Width="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight}"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusBarText}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
